; Harbor Jelly - an original miniature jelly harbour, Android-first Godot 4 project
config_version=5

[application]
config/name="Harbor Jelly"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.929, 0.912, 0.886, 1)
anti_aliasing/quality/msaa_3d=2

[physics]
3d/default_gravity=9.8
